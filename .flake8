# PEP 8 с двумя согласованными отступлениями (PEP 8 это разрешает):
# - лимит 99 знаков вместо 79 (длинные Django-вызовы и кириллические докстринги);
# - в миграциях E501 не считаем: код автогенерируемый, а перенос строки внутри
#   RunPython меняет сам миграцию.
[flake8]
max-line-length = 99
exclude =
    .git,
    .venv,
    __pycache__,
    static,
    media
extend-ignore =
    # 79-знаковый лимит в миграциях
    E501

per-file-ignores =
    */migrations/*:E501
